# 环境变量示例 —— 复制为 .env 后填入真实值
#
# ⚠️ .env 已在 .gitignore 中，绝不会进入仓库或提交历史。
# ⚠️ 本文件只放占位符，任何真实凭证都不得写入。

# 数据源：miaoxiang | public | fixture
REITS_DATA_SOURCE=fixture

# 妙想 MCP（如需直连，非必填；MCP 客户端模式下由宿主注入）
MIAOXIANG_ENDPOINT=
MIAOXIANG_TOKEN=

# 可选：直连模型 API 用于起草（默认走 task packet，不需要此配置）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# 运行限额
REITS_MAX_WALL_CLOCK_SEC=3600
REITS_MAX_TOOL_CALLS=300
